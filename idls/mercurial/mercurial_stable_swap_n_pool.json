    "source": "github.com/mercurial-finance/stable-swap-n-pool-instructions (src/instruction.rs, src/state.rs) + stable-swap-n-pool-js"
  },
  "address": "MERLuDFBMmsHnsBPZw2sDQZHvXFMwp8EdjudcU2HKky"
}
